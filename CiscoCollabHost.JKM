[Common Keys]
Shift+JAWSKey+F1= 
Shift+JAWSKey+Z=GetTechnicalInfo
Shift+Control+S=CheckMuteStatus
Shift+Control+G=ActivateCheckFirstButton
Shift+Control+T=ActivateTransferNowButton
Shift+Control+Z=ActivateEraseEntryButton
Shift+Control+Q=ActivateCancelButton
Shift+Control+K=ActivateKeyboardButton
Shift+Control+H=GetHistorialList
Insert+H=HotKeyHelp
